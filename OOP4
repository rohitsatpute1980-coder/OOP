#include <iostream>
using namespace std;

class Book
{
    string name;
    string author;
    float price;

public:

    // Default constructor
    Book()
    {
        name = "Unknown";
        author = "Unknown";
        price = 0;
    }

    // Parameterized constructor
    Book(string n, string a, float p)
    {
        name = n;
        author = a;
        price = p;
    }

    void display()
    {
        cout << "Book Name : " << name << endl;
        cout << "Author    : " << author << endl;
        cout << "Price     : Rs." << price << endl;
    }
};

int main()
{
    Book book1;
    Book book2("C++ Basics", "R.K. Sharma", 450);

    cout << "--- Default Book ---" << endl;
    book1.display();

    cout << "\n--- Complete Book Details ---" << endl;
    book2.display();

    return 0;
}
