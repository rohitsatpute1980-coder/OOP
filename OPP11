#include <iostream>
using namespace std;

template <class T>
T findLarger(T a, T b)
{
    if (a > b)
        return a;
    else
        return b;
}

int main()
{
    cout << "Larger integer: " << findLarger(10, 20) << endl;
    cout << "Larger float: " << findLarger(5.5, 8.2) << endl;
    cout << "Larger value: " << findLarger(25, 15) << endl;

    return 0;
}