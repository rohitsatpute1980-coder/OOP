#include <iostream>
using namespace std;

template <typename T>
void swapValues(T &a, T &b)
{
    cout << "Before swapping" << endl;
    cout << "a = " << a << endl;
    cout << "b = " << b << endl;

    T c = a;
    a = b;
    b = c;

    cout << "After swapping" << endl;
    cout << "a = " << a << endl;
    cout << "b = " << b << endl;
}

int main()
{
    int a = 10, b = 20;
    swapValues(a, b);

    return 0;
}