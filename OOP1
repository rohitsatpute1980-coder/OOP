#include <iostream>
using namespace std;

class Book
{
    string title;
    string author;
    float price;

public:
    void getDetails()
    {
        cout << "Enter book title: ";
        cin >> title;

        cout << "Enter author name: ";
        cin >> author;

        cout << "Enter price: ";
        cin >> price;
    }

    void showDetails()
    {
        cout << "\n--- Book Details ---" << endl;
        cout << "Title  : " << title << endl;
        cout << "Author : " << author << endl;
        cout << "Price  : " << price << endl;
    }
};

int main()
{
    Book book1;

    book1.getDetails();
    book1.showDetails();

    return 0;
}